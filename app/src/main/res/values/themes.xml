<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Wishwell" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Overrides Glance's internal list style so the widget's LazyColumn does not draw a scrollbar. -->
    <style name="Glance.AppWidget.List" parent="">
        <item name="android:scrollbars">none</item>
    </style>
</resources>
